# 🔮 scry.quest Environment Configuration Template 🔮
# Copy this file to .env and update the values as needed

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level: debug, info, warn, error
SCRY_LOG_LEVEL=info

# Log format: json, text
SCRY_LOG_FORMAT=text

# =============================================================================
# Embeddings Engine Configuration
# =============================================================================

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

# =============================================================================
# Database Configuration
# =============================================================================

SCRY_DATABASE_URL=postgres://scry_quest:scry_quest_dev@localhost/scry_quest

# Add other SCRY_ prefixed environment variables as needed
# Examples:
# SCRY_PORT=8080
# SCRY_API_KEY=????
